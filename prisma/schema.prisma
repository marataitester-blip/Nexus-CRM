generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Platform {
  TELEGRAM
  YOUTUBE
  KICKSTARTER
  WEB
  OTHER
}

enum Status {
  NEW
  CONTACTED
  NEGOTIATING
  PARTNER
  REJECTED
}

// Добавлены языковые сегменты, включая турецкий (TR)
enum Language {
  RU
  EN
  DE
  ES
  FR
  PL
  TR
  OTHER
}

model Lead {
  id          String   @id @default(uuid())
  name        String
  url         String   @unique
  description String?
  platform    Platform @default(OTHER)
  status      Status   @default(NEW)
  language    Language @default(RU) // По умолчанию русский сегмент
  aiScore     Int?     // Оценка от OpenRouter (1-10)
  aiComment   String?  // Краткий комментарий ИИ
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  notes       Note[]
}

model Note {
  id        String   @id @default(uuid())
  text      String
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model Keyword {
  id        String   @id @default(uuid())
  word      String   @unique
  category  String?  
  createdAt DateTime @default(now())
}
